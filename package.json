{
  "name": "teachers-day-tribute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "start": "NODE_ENV=production node server/index.js",
    "install:all": "npm install && npm --prefix client install",
    "setup": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^4.19.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "drizzle-kit": "^1.0.0-beta.22"
  }
}
